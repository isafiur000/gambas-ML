              Text = ("Precision, Recall, F1 Score")
            }
            { lblaverage Label
              MoveScaled(1,7.5,10,3)
              Border = Border.Plain
              Text = ("Average")
            }
            { cmbscoreaverage ComboBox
              MoveScaled(12,7.5,18,3)
            }
          }
          { Panel11 Panel
            MoveScaled(1,15,35,4)
            { btnevaluate Button
              MoveScaled(6,0.5,17,3)
              Enabled = False
              Text = ("Calculate")
            }
          }
          { pnlunsuper Panel
            MoveScaled(1,21,35,4)
            Visible = False
            { btnunsupervised Button
              MoveScaled(18,0.5,14,3)
              Text = ("Dataset")
            }
            { chksavefile CheckBox
              MoveScaled(1,0.5,13,3)
              Text = ("Save File")
            }
          }
        }
        { Panel17 Panel
          MoveScaled(1,28,37,4)
          { btnopen ToolButton
            MoveScaled(25,0.5,3,3)
            Picture = Picture["icon:/small/image"]
          }
          { chkpredictplot CheckBox
            MoveScaled(1,0.5,17,3)
            Text = ("Plot Output")
          }
          { btnshowscatterplot ToolButton
            MoveScaled(20,0.5,3.5,3)
            Picture = Picture["icon:/small/apply"]
          }
          { btntreeinstal ToolButton
            MoveScaled(33,0.5,3,3)
            Picture = Picture["icon:/small/exec"]
          }
        }
        Index = 7
        Text = ("Prediction")
        { btnpredict Button
          MoveScaled(1,1,15,3)
          Text = ("Prediction")
        }
        { txtpredict TextBox
          MoveScaled(17,1,26,3)
        }
        { Button1 Button
          MoveScaled(17,5,25,4)
          Text = ("Dump Outputs")
        }
        Index = 0
      }
    }
    { Panel4 Panel
      MoveScaled(-1,47,121,30)
      Expand = True
      Arrangement = Arrange.Vertical
      { TerminalView1 TerminalView
        MoveScaled(4,2,85,24)
        Background = Color.White
        Foreground = Color.Black
        Expand = True
        Blink = True
      }
    }
  }
}
